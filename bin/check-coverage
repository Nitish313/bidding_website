#!/usr/bin/env ruby
# Fails (exit 1) when the last test run's line coverage is below the minimum set in
# .simplecov. CI runs this as its own step so the coverage gate is visible, and when
# GITHUB_STEP_SUMMARY is set it also adds a coverage table to the job's summary page.
#
#   bin/check-coverage [path/to/.last_run.json]
require "json"

root = File.expand_path("..", __dir__)
result_path = ARGV[0] || File.join(root, "coverage", ".last_run.json")
minimum = File.read(File.join(root, ".simplecov"))[/^\s*minimum_coverage\s+(\d+(?:\.\d+)?)/, 1]
abort "No minimum_coverage found in .simplecov" unless minimum

unless File.exist?(result_path)
  abort "No coverage result at #{result_path}. Run the test suite first."
end

coverage = JSON.parse(File.read(result_path)).dig("result", "line").to_f
minimum = minimum.to_f
minimum_text = "#{minimum.to_s.delete_suffix('.0')}%"
verdict = coverage < minimum ? "below the minimum" : "ok"

summary_path = ENV.fetch("GITHUB_STEP_SUMMARY", "")
unless summary_path.empty?
  File.open(summary_path, "a") do |summary|
    summary.puts "### Test coverage", "", "| | |", "|---|---|",
                 "| Line coverage | #{coverage.round(2)}% |", "| Minimum | #{minimum_text} |", "| Result | #{verdict} |"
  end
end

message = "Line coverage #{coverage.round(2)}% (minimum #{minimum_text}): #{verdict}"
coverage < minimum ? abort(message) : puts(message)
