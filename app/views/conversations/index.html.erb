<h1>All conversations</h1>
<table class="table table-striped">
	<% if @conversations.any? %>
		<thead>
			<tr>
				<th>Subject</th>
				<th>Creator</th>
				<th>Other User</th>
			</tr>
		</thead>
	<% end %>
	<% @conversations.each do |conversation| %>
		<tr>
			<td><%= link_to conversation.subject, user_conversation_path(id: conversation.id ) %></td>
			<td><%= link_to_user_or_deleted(conversation.originator) %></td>
			<td><%= link_to_user_or_deleted(conversation.other_participant(@user)) %></td>
			<td>
				<% if @unread_ids.include?(conversation.id) && current_user?(@user) %>
					<%= link_to 'Mark as read', mark_as_read_user_conversation_path(id: conversation.id), class: 'btn btn-xs btn-info', method: :post %>
				<% end %>
			</td>
			<td><%= link_to "Delete this conversation", user_conversation_path(id: conversation.id), method: :delete, data: {confirm: "Are you sure?"} if current_user?(@user) %></td>
		</tr>
	<% end %>
</table>
<%= link_to 'New Conversation', new_user_conversation_path if current_user?(@user) %>