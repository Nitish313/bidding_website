# Copy to .env and adjust. docker compose passes these to the web container;
# .env is git-ignored, so real secrets never get committed.

# Admin account created by `bin/rails db:seed`. Leave the password empty to
# have a random one generated and printed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# Database connection when running without Docker (docker compose sets these itself).
# DB_USERNAME=root
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=3306

# Puma threads and Active Record connection pool size.
# RAILS_MAX_THREADS=5
