# Copy to .env and adjust. docker compose passes these to the web container;
# .env is git-ignored, so real secrets never get committed.

# Admin account created by `bin/rails db:seed`. Leave the password empty to
# have a random one generated and printed.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=

# User and group the app container runs as (default 1000). Set these to the
# output of `id -u` and `id -g` if yours differ, so files the app writes are yours.
# HOST_UID=1000
# HOST_GID=1000

# Error reporting (sentry.io or any Sentry-compatible service). Nothing is sent while
# SENTRY_DSN is empty. Trace sample rate: 0 (off) to 1 (every request).
SENTRY_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_RELEASE=

# Database connection when running without Docker (docker compose sets these itself).
# DB_USERNAME=root
# DB_PASSWORD=
# DB_HOST=
# DB_PORT=3306

# Puma threads and Active Record connection pool size.
# RAILS_MAX_THREADS=5
